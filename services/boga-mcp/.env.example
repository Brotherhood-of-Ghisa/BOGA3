# Public URL where MCP clients reach this service.
BOGA_MCP_PUBLIC_URL=https://mcp.example.com

# Dedicated read-only BoGa agent API base. Do not use a PostgREST/database URL.
BOGA_AGENT_API_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/agent-api

# OAuth authorization server issuer advertised to MCP clients.
BOGA_OAUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1

# Optional runtime settings.
PORT=8787
BOGA_AGENT_API_TIMEOUT_MS=10000
