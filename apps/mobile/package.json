{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "start:ios:dev-client": "./scripts/ios-dev-client-start.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:ui-guardrails": "node ./scripts/check-ui-guardrails.js",
    "router:types": "node ./scripts/generate-router-types.js",
    "typecheck": "npm run router:types && tsc --noEmit",
    "test": "jest",
    "test:sync": "jest app/__tests__/sync",
    "test:sync:infra": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --runInBand --runTestsByPath app/__tests__/sync/drift-check.test.ts app/__tests__/sync/cycle-round-trip.test.ts app/__tests__/sync/cycle-multidevice-lww.test.ts app/__tests__/sync/auth-required-envelope.test.ts app/__tests__/sync/update-softdelete-roundtrip.test.ts app/__tests__/sync/future-clock-clamp.test.ts --testPathIgnorePatterns=/node_modules/",
    "test:handles": "jest --detectOpenHandles --silent",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts && tsx scripts/bundle-migrations.ts",
    "db:generate:canary": "npm run db:generate",
    "check:sync-drift": "tsx scripts/check-sync-schema-drift.ts",
    "test:e2e:ios:smoke": "./scripts/maestro-run-lane.sh smoke",
    "test:e2e:ios:data-smoke": "./scripts/maestro-run-lane.sh data-smoke",
    "test:e2e:ios:gates": "./scripts/maestro-ios-gates.sh",
    "test:e2e:ios:ui-regression": "./scripts/maestro-run-lane.sh ui-regression",
    "test:e2e:ios:exercise-page": "./scripts/maestro-run-lane.sh exercise-page",
    "test:e2e:ios:session-view": "./scripts/maestro-run-lane.sh session-view",
    "test:e2e:ios:bodyweight": "./scripts/maestro-run-lane.sh bodyweight",
    "test:e2e:ios:auth-profile": "./scripts/maestro-run-lane.sh auth-profile",
    "test:e2e:ios:sync": "./scripts/maestro-run-lane.sh sync-e2e",
    "test:e2e:ios:groups": "./scripts/maestro-run-lane.sh groups-e2e",
    "digest:gymbook": "tsx scripts/import/gymbook-digester.ts",
    "import:boga-json:local": "tsx scripts/import/import-boga-json-local.ts",
    "import:boga-json:remote": "tsx scripts/import/import-boga-json-remote.ts",
    "import:boga-json:enrich-set-types": "tsx scripts/import/enrich-boga-import-set-types.ts",
    "seed:dev-rich-history": "tsx scripts/import/seed-dev-rich-history.ts"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.98.0",
    "drizzle-orm": "^0.44.6",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.20",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.4",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "globals": "^14.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pg": "^8.21.0",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
