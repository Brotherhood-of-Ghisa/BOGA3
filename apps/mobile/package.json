{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "start:ios:dev-client": "./scripts/ios-dev-client-start.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:ui-guardrails": "node ./scripts/check-ui-guardrails.js",
    "lint:complexity": "eslint --quiet -c eslint.complexity.config.js --suppressions-location eslint-complexity-suppressions.json app components src",
    "lint:deps": "depcruise -c dependency-cruiser.config.cjs --ignore-known dependency-cruiser-known-violations.json -T err app components src",
    "lint:deps:prune": "depcruise -c dependency-cruiser.config.cjs --baseline dependency-cruiser-known-violations.json --baseline-mode shrink-only app components src",
    "router:types": "node ./scripts/generate-router-types.js",
    "typecheck": "npm run router:types && tsc --noEmit",
    "test": "jest",
    "test:sync": "jest __tests__/sync",
    "test:sync:infra": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --runInBand --runTestsByPath __tests__/sync/drift-check.test.ts __tests__/sync/cycle-round-trip.test.ts __tests__/sync/cycle-multidevice-lww.test.ts __tests__/sync/block-attachment-arbitration-cycle.test.ts __tests__/sync/auth-required-envelope.test.ts __tests__/sync/update-softdelete-roundtrip.test.ts __tests__/sync/future-clock-clamp.test.ts __tests__/sync/cycle-fresh-device-and-account-switch.test.ts --testPathIgnorePatterns=/node_modules/",
    "test:groups:competition-live": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --runInBand --runTestsByPath __tests__/groups-competition-api-live.test.ts --testPathIgnorePatterns=/node_modules/",
    "test:groups:live": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --runInBand --runTestsByPath __tests__/groups-api-live.test.ts --testPathIgnorePatterns=/node_modules/",
    "test:handles": "jest --detectOpenHandles --silent",
    "test:coverage": "jest --coverage --silent",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts && tsx scripts/bundle-migrations.ts",
    "db:generate:canary": "npm run db:generate",
    "check:sync-drift": "tsx scripts/check-sync-schema-drift.ts",
    "test:e2e:ios:smoke": "./scripts/maestro-run-lane.sh smoke",
    "test:e2e:ios:data-smoke": "./scripts/maestro-run-lane.sh data-smoke",
    "test:e2e:ios:gates": "./scripts/maestro-ios-gates.sh",
    "test:e2e:ios:exercise-page": "./scripts/maestro-run-lane.sh exercise-page",
    "test:e2e:ios:session-view": "./scripts/maestro-run-lane.sh session-view",
    "test:e2e:ios:auth-profile": "./scripts/maestro-run-lane.sh auth-profile",
    "test:e2e:ios:sync": "./scripts/maestro-run-lane.sh sync-e2e",
    "test:e2e:ios:groups": "./scripts/maestro-run-lane.sh groups-e2e",
    "test:e2e:android:smoke": "./scripts/maestro-run-lane.sh android-smoke",
    "test:e2e:android:data-smoke": "./scripts/maestro-run-lane.sh android-data-smoke",
    "digest:gymbook": "tsx scripts/import/gymbook-digester.ts",
    "import:boga-json:local": "tsx scripts/import/import-boga-json-local.ts",
    "import:boga-json:remote": "tsx scripts/import/import-boga-json-remote.ts",
    "import:boga-json:enrich-set-types": "tsx scripts/import/enrich-boga-import-set-types.ts",
    "seed:dev-rich-history": "tsx scripts/import/seed-dev-rich-history.ts",
    "seed:dev-groups": "tsx scripts/import/seed-dev-groups.ts"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.98.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~58.0.3",
    "expo-application": "~58.0.3",
    "expo-background-task": "~58.0.10",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.9",
    "expo-dev-client": "~58.0.11",
    "expo-font": "~58.0.6",
    "expo-linking": "~58.0.10",
    "expo-location": "~58.0.11",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.14",
    "expo-splash-screen": "~58.0.5",
    "expo-sqlite": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.5",
    "expo-task-manager": "~58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.1",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0-rc.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.3.0",
    "better-sqlite3": "12.11.1",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^14.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.7",
    "pg": "^8.21.0",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
