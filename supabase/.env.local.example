# Optional overrides for local helper scripts.
# `./boga worktree start` links `supabase/.env.local` to
# `~/.config/boga/supabase/cli.env` for all local worktrees.

# The repo pins the Supabase CLI (BOGA_SUPABASE_CLI_DEFAULT_VERSION in
# scripts/worktree-lib.sh). Uncomment only to try another CLI; versions below
# BOGA_SUPABASE_CLI_MIN_VERSION are rejected because their edge runtime needs
# deno.land at every start.
# SUPABASE_CLI_VERSION=
