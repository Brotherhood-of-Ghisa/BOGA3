#!/usr/bin/env bash

# boga — the single entrypoint for this repo's gates, lanes, and ops.
#
# Runnable from anywhere inside the repo; it resolves its own root. Lanes are
# defined in scripts/lanes.tsv (the lane registry); every lane run is timed and
# recorded under docs/testing/timings/records/ (read back with `boga timings`).
#
#   boga test fast|backend|frontend|slow|all   # gate aggregates
#   boga test <lane>                           # one lane by registry name
#   boga test --list                           # what exists, where it runs
#   boga test <lane> --dry-run                 # print the command, don't run
#   boga test for [--diff <range>] [paths...]  # which gates does a change require?
#   boga pr check --body <file|->              # validate a PR body's Tests table
#   boga pr wait [--interval <s>]              # block until this branch's PR merges/closes
#   boga doctor [--android]                    # can THIS machine run every lane (or Android dev)?
#   boga android doctor|run|start              # verify Android environment or run dev client
#   boga docs gen|check                        # (re)generate / drift-check derived doc blocks
#   boga timings [lane]                        # measured durations (never guess)
#   boga worktree create|start|ls|release|doctor   # agent-owned lifecycle (spec 01)
#   boga db up|down|reset|baseline             # this slot's stack (gates)
#   boga db dev|dev-up|dev-down|dev-reset       # dedicated dev stack (BOGA-dev), isolated from gates
#   boga ios build-client|start
#   boga env dev|lan|hosted|tailscale
#   boga task bootstrap|closeout
#
# `test` (except --list / for), `db`, `ios`, and `env` fail hard without this
# worktree's slot lease: run `boga worktree start` first.
#
# Legacy entrypoints ./scripts/quality-fast.sh and ./scripts/quality-slow.sh
# forward here.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LANES_TSV="${REPO_ROOT}/scripts/lanes.tsv"

# shellcheck disable=SC1091
source "${REPO_ROOT}/scripts/worktree-lib.sh"
# shellcheck disable=SC1091
source "${REPO_ROOT}/scripts/lane-timing.sh"
# shellcheck disable=SC1091
source "${REPO_ROOT}/scripts/java-env.sh"
if [[ -f "${REPO_ROOT}/scripts/android-env.sh" ]]; then
  # shellcheck disable=SC1091
  source "${REPO_ROOT}/scripts/android-env.sh"
fi

usage() {
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "${BASH_SOURCE[0]}"
}

require_lease() {
  boga_require_slot_lease "${REPO_ROOT}" || exit 1
}

fail() {
  echo "[boga] $*" >&2
  exit 1
}

# ---------- lane registry ----------

# Iterates registry rows as: name<TAB>gate<TAB>infra<TAB>ci<TAB>cwd<TAB>command
lanes_rows() {
  grep -v '^[[:space:]]*#' "${LANES_TSV}" | grep -v '^[[:space:]]*$'
}

lane_lookup() {
  local name="$1"
  lanes_rows | awk -F'\t' -v n="${name}" '$1 == n { print; found=1 } END { exit !found }'
}

# Frontend lanes need apps/mobile deps; mirror the old gate bootstrap.
ensure_mobile_deps() {
  [[ -f "${REPO_ROOT}/apps/mobile/package.json" ]] || return 0
  if [[ ! -d "${REPO_ROOT}/apps/mobile/node_modules" ]]; then
    echo "[boga] mobile dependencies missing; installing (worktree-local)"
    (cd "${REPO_ROOT}/apps/mobile" && npm install)
  fi
}

run_lane_row() {
  local row="$1" dry="$2"
  local name cwd cmd
  name="$(printf '%s' "${row}" | cut -f1)"
  cwd="$(printf '%s' "${row}" | cut -f5)"
  cmd="$(printf '%s' "${row}" | cut -f6)"

  if [[ "${dry}" == "1" ]]; then
    echo "[boga] ${name}: (cd ${cwd} && ${cmd})"
    return 0
  fi

  [[ "${cwd}" == "apps/mobile" ]] && ensure_mobile_deps

  echo "[boga] lane: ${name}  (cd ${cwd} && ${cmd})"
  lane_body() { (cd "${REPO_ROOT}/${cwd}" && eval "${cmd}"); }
  boga_time_lane "${name}" lane_body
}

run_gate() {
  local dry="$1"
  shift
  local gates=("$@")
  local row matched=0
  for gate in "${gates[@]}"; do
    while IFS= read -r row; do
      matched=1
      run_lane_row "${row}" "${dry}"
    done < <(lanes_rows | awk -F'\t' -v g="${gate}" '$2 == g')
  done
  [[ "${matched}" == "1" ]] || fail "no lanes found for gate(s): ${gates[*]}"
}

cmd_test() {
  # `boga test for ...` → the trigger matcher (scripts/triggers.tsv)
  if [[ "${1:-}" == "for" ]]; then
    shift
    exec "${REPO_ROOT}/scripts/test-for.sh" "$@"
  fi
  local target="" dry=0
  for arg in "$@"; do
    case "${arg}" in
      --dry-run) dry=1 ;;
      --list) target="--list" ;;
      *) target="${arg}" ;;
    esac
  done
  [[ -n "${target}" ]] || fail "usage: boga test <gate|lane|--list|for> [--dry-run]"
  [[ "${target}" == "--list" ]] || require_lease

  case "${target}" in
    --list)
      echo "Lanes (scripts/lanes.tsv). Gates: fast | backend | frontend | slow | all."
      echo "Durations: ./boga timings   Capability: ./boga doctor"
      echo
      printf '%-20s %-15s %-13s %-4s %-12s %s\n' "LANE" "GATE" "INFRA" "CI" "CWD" "COMMAND"
      lanes_rows | awk -F'\t' '{ printf "%-20s %-15s %-13s %-4s %-12s %s\n", $1, $2, $3, $4, $5, $6 }'
      ;;
    fast)          run_gate "${dry}" fast-frontend fast-backend fast-repo ;;
    fast-frontend) run_gate "${dry}" fast-frontend ;;
    fast-backend)  run_gate "${dry}" fast-backend ;;
    fast-repo)     run_gate "${dry}" fast-repo ;;
    backend)       run_gate "${dry}" slow-backend ;;
    frontend)      run_gate "${dry}" slow-frontend ;;
    slow)          run_gate "${dry}" slow-frontend slow-backend ;;
    all)           run_gate "${dry}" fast-frontend fast-backend fast-repo slow-frontend slow-backend ;;
    *)
      local row
      row="$(lane_lookup "${target}")" || fail "unknown lane or gate: '${target}' (see: boga test --list)"
      run_lane_row "${row}" "${dry}"
      ;;
  esac
}

cmd_android_doctor() {
  echo "[boga doctor --android] Android capability checks"
  local ok=0
  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      echo "  OK   ${label}"
    else
      echo "  FAIL ${label}  (fix this, then Android builds run)"
      ok=1
    fi
  }
  check "Android SDK (ANDROID_HOME)" test -n "${ANDROID_HOME:-}" -a -d "${ANDROID_HOME:-}"
  check "adb (Android platform tools)" adb version
  check "emulator (Android emulator CLI)" emulator -version
  check_gradle_java() {
    local java_bin=""
    if [[ -n "${JAVA_HOME:-}" ]]; then
      if [[ ! -d "${JAVA_HOME}" || ! -x "${JAVA_HOME}/bin/java" ]]; then
        return 1
      fi
      java_bin="${JAVA_HOME}/bin/java"
    elif command -v java >/dev/null 2>&1; then
      java_bin="$(command -v java)"
    else
      return 1
    fi
    local ver
    ver="$("${java_bin}" -version 2>&1 | head -n 1 | awk -F '"' '{print $2}' | cut -d'.' -f1)"
    [[ "$ver" == "17" || "$ver" == "21" ]]
  }
  check "java runtime for Gradle is Java 17 or 21 (JAVA_HOME / PATH)" check_gradle_java
  check_android_target() {
    local avds
    avds="$(emulator -list-avds 2>/dev/null || true)"
    if [[ -n "${avds}" ]]; then
      return 0
    fi
    local dev_count
    dev_count="$(adb devices 2>/dev/null | grep -v "List of devices" | grep -c "device$" || true)"
    (( dev_count > 0 ))
  }
  check "Android device target (AVD created or device connected)" check_android_target
  return "${ok}"
}

cmd_android_launch() {
  local action="$1"
  shift
  ensure_mobile_deps
  local mobile_dir="${REPO_ROOT}/apps/mobile"
  local slot port
  slot="$(boga_read_slot_file "${REPO_ROOT}")"
  port="$(boga_port_for_slot expo "${slot}")"
  local maestro_env="${mobile_dir}/.maestro/maestro.env.local"
  if [[ -f "${maestro_env}" ]]; then
    # This trusted, generated file contains shell defaults, not dotenv values.
    # Keep its iOS-specific settings out of this launcher.
    port="$(source "${maestro_env}"; printf '%s' "${EXPO_DEV_SERVER_PORT:-${port}}")"
  else
    port="${EXPO_DEV_SERVER_PORT:-${port}}"
  fi
  local expo_args=()
  while (( $# )); do
    case "$1" in
      --port) (( $# >= 2 )) || fail "--port requires a number"; port="$2"; shift 2 ;;
      --port=*) port="${1#--port=}"; shift ;;
      *) expo_args+=("$1"); shift ;;
    esac
  done
  [[ "${port}" =~ ^[0-9]{1,5}$ ]] && (( 10#${port} >= 1 && 10#${port} <= 65535 )) \
    || fail "Android Metro port must be a number from 1 to 65535 (got '${port}')"
  export EXPO_DEV_SERVER_PORT="${port}"
  if [[ -f "${mobile_dir}/.env.local" ]]; then
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/scripts/dev/export-mobile-supabase-env.sh" "${mobile_dir}/.env.local"
  fi
  local api_port
  api_port="$(node -e '
    const value = process.env.EXPO_PUBLIC_SUPABASE_URL;
    if (!value) process.exit(0);
    const url = new URL(value);
    if (["127.0.0.1", "localhost", "[::1]"].includes(url.hostname)) {
      console.log(url.port || (url.protocol === "https:" ? "443" : "80"));
    }
  ')" || fail "Invalid EXPO_PUBLIC_SUPABASE_URL"
  command -v adb >/dev/null 2>&1 || fail "adb is missing; run ./boga doctor --android"
  adb reverse "tcp:${port}" "tcp:${port}" \
    || fail "Could not forward Metro; boot/connect one Android target (or set ANDROID_SERIAL)"
  if [[ -n "${api_port}" ]]; then
    adb reverse "tcp:${api_port}" "tcp:${api_port}" \
      || fail "Could not forward the local Supabase API port ${api_port}"
  fi
  echo "[boga android ${action}] launching Expo (Metro port ${port})"
  if [[ "${action}" == "run" ]]; then
    (cd "${mobile_dir}" && exec npx expo run:android --port "${port}" ${expo_args[@]+"${expo_args[@]}"})
  else
    (cd "${mobile_dir}" && exec npx expo start --dev-client --port "${port}" ${expo_args[@]+"${expo_args[@]}"})
  fi
}

cmd_doctor() {
  local target="${1:-}"
  if [[ "${target}" == "--android" || "${target}" == "android" ]]; then
    cmd_android_doctor
    return $?
  fi

  echo "[boga doctor] capability checks — a FAIL is a bootstrap gap to fix, not a reason to skip a lane"
  local ok=0
  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      echo "  OK   ${label}"
    else
      echo "  FAIL ${label}  (fix this, then the lane runs)"
      ok=1
    fi
  }
  check "docker daemon answers within 10s (local Supabase lanes)" boga_run_with_timeout 10 docker info
  check "gh authenticated (worktree release / pr wait)" gh auth status
  check "iOS simulators (Maestro lanes)" xcrun simctl list devices available
  check "maestro CLI (Maestro lanes)" maestro --version
  check "xcodebuild (dev-client build)" xcodebuild -version
  check "node" node --version
  check "jq (worktree tooling)" jq --version
  if [[ -x "${REPO_ROOT}/scripts/worktree-doctor.sh" ]]; then
    echo "[boga doctor] worktree diagnostics:"
    "${REPO_ROOT}/scripts/worktree-doctor.sh" || ok=1
  fi
  return "${ok}"
}

dispatch_script() {
  local script="$1"
  shift
  [[ -x "${script}" ]] || fail "missing or not executable: ${script}"
  exec "${script}" "$@"
}

cmd="${1:-help}"
shift || true

case "${cmd}" in
  test)     cmd_test "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  android)
    sub="${1:-doctor}"; shift || true
    case "${sub}" in
      doctor) cmd_android_doctor "$@" ;;
      run|start) require_lease; cmd_android_launch "${sub}" "$@" ;;
      *) fail "usage: boga android doctor | run [--no-bundler] [...] | start [...]" ;;
    esac
    ;;
  pr)
    sub="${1:-}"; shift || true
    case "${sub}" in
      check) exec "${REPO_ROOT}/scripts/pr-check.sh" "$@" ;;
      wait)  exec "${REPO_ROOT}/scripts/pr-wait.sh" "$@" ;;
      *) fail "usage: boga pr check --body <file|-> [--diff <range>] [--strict] | boga pr wait [--interval <s>]" ;;
    esac
    ;;
  docs)
    sub="${1:-check}"
    case "${sub}" in
      gen|check) exec "${REPO_ROOT}/scripts/gen-docs.sh" "${sub}" ;;
      *) fail "usage: boga docs gen|check" ;;
    esac
    ;;
  timings)  dispatch_script "${REPO_ROOT}/scripts/test-timings.sh" "$@" ;;
  worktree)
    sub="${1:-}"; shift || true
    case "${sub}" in
      create|start|ls|release|doctor) dispatch_script "${REPO_ROOT}/scripts/worktree-${sub}.sh" "$@" ;;
      *) fail "usage: boga worktree create|start|ls|release|doctor   (lifecycle: docs/specs/01-worktree-and-environment.md)" ;;
    esac
    ;;
  db)
    require_lease
    sub="${1:-}"; shift || true
    case "${sub}" in
      up)       dispatch_script "${REPO_ROOT}/supabase/scripts/local-runtime-up.sh" "$@" ;;
      down)     dispatch_script "${REPO_ROOT}/supabase/scripts/local-runtime-down.sh" "$@" ;;
      reset)    dispatch_script "${REPO_ROOT}/supabase/scripts/reset-local.sh" "$@" ;;
      baseline) dispatch_script "${REPO_ROOT}/supabase/scripts/ensure-local-runtime-baseline.sh" "$@" ;;
      dev)        dispatch_script "${REPO_ROOT}/supabase/scripts/ensure-dev-baseline.sh" "$@" ;;
      dev-up)     dispatch_script "${REPO_ROOT}/supabase/scripts/dev-runtime-up.sh" "$@" ;;
      dev-down)   dispatch_script "${REPO_ROOT}/supabase/scripts/dev-runtime-down.sh" "$@" ;;
      dev-reset)  dispatch_script "${REPO_ROOT}/supabase/scripts/dev-reset.sh" "$@" ;;
      *) fail "usage: boga db up|down|reset|baseline | dev|dev-up|dev-down|dev-reset" ;;
    esac
    ;;
  ios)
    require_lease
    sub="${1:-}"; shift || true
    case "${sub}" in
      build-client) dispatch_script "${REPO_ROOT}/apps/mobile/scripts/maestro-ios-dev-client-build.sh" "$@" ;;
      start)        dispatch_script "${REPO_ROOT}/apps/mobile/scripts/ios-dev-client-start.sh" "$@" ;;
      *) fail "usage: boga ios build-client|start" ;;
    esac
    ;;
  env)
    require_lease
    sub="${1:-}"; shift || true
    case "${sub}" in
      lan)       dispatch_script "${REPO_ROOT}/scripts/dev/use-local-mobile-lan-env.sh" "$@" ;;
      dev)       dispatch_script "${REPO_ROOT}/scripts/dev/use-local-mobile-dev-env.sh" "$@" ;;
      hosted)    dispatch_script "${REPO_ROOT}/scripts/dev/use-hosted-mobile-env.sh" "$@" ;;
      tailscale) dispatch_script "${REPO_ROOT}/scripts/dev/use-local-mobile-tailscale-env.sh" "$@" ;;
      *) fail "usage: boga env dev|lan|hosted|tailscale   (full phone sessions: scripts/dev/dev-lan.sh on-LAN, scripts/dev/dev-remote.sh over Tailscale)" ;;
    esac
    ;;
  task)
    sub="${1:-}"; shift || true
    case "${sub}" in
      bootstrap) dispatch_script "${REPO_ROOT}/scripts/task-bootstrap.sh" "$@" ;;
      closeout)  dispatch_script "${REPO_ROOT}/scripts/task-closeout-check.sh" "$@" ;;
      *) fail "usage: boga task bootstrap|closeout" ;;
    esac
    ;;
  help|--help|-h) usage ;;
  *)
    echo "[boga] unknown command: ${cmd}" >&2
    usage >&2
    exit 2
    ;;
esac
